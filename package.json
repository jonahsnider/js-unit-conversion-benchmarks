{
	"name": "@jonahsnider/js-unit-conversion-benchmarks",
	"version": "1.0.0",
	"private": true,
	"description": "Some benchmarks of community-made libraries for converting units.",
	"license": "MIT",
	"author": {
		"name": "Jonah Snider",
		"email": "jonah@jonah.pw",
		"url": "https://jonahsnider.com"
	},
	"type": "module",
	"scripts": {
		"build": "tsc",
		"start": "NODE_ENV=production node src/index.ts",
		"style": "prettier --check .",
		"test": "node --test"
	},
	"prettier": "@jonahsnider/prettier-config",
	"dependencies": {
		"@jonahsnider/benchmark": "6.0.1",
		"@jonahsnider/util": "13.0.0",
		"@lukeed/ms": "2.0.2",
		"byte-size": "9.0.1",
		"convert": "7.0.2",
		"convert-units": "3.0.0-beta.8",
		"dayjs": "1.11.23",
		"js-quantities": "1.8.0",
		"luxon": "3.7.2",
		"moment": "2.30.1",
		"ms": "2.1.3",
		"prettier": "3.9.6",
		"safe-units": "2.0.1",
		"simple-units": "1.1.5",
		"uom": "6.1.0",
		"uom-units": "4.5.0"
	},
	"devDependencies": {
		"@jonahsnider/prettier-config": "2.0.2",
		"@tsconfig/node-ts": "^23.6.4",
		"@tsconfig/node26": "^26.0.0",
		"@tsconfig/strictest": "2.0.8",
		"@types/byte-size": "8.1.2",
		"@types/js-quantities": "1.6.6",
		"@types/luxon": "3.7.5",
		"@types/ms": "2.1.0",
		"@types/node": "26.4.1",
		"typescript": "7.0.2"
	},
	"packageManager": "pnpm@12.3.0",
	"engines": {
		"node": ">=26"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.x",
			"onFail": "download"
		}
	}
}
